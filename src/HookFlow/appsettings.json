{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=hookflow.db"
  },
  "HookFlow": {
    "MaxRetryAttempts": 5,
    "InitialBackoffSeconds": 2,
    "DeliveryTimeoutSeconds": 10,
    "WorkerConcurrency": 4
  },
  "AllowedHosts": "*"
}
